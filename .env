# Copy to .env and edit.

# Anyone on your work LAN can reach this app. Set a password.
HELPDESK_PASSWORD=change-me

# Keeps you signed in across restarts. Any long random string.
HELPDESK_SECRET_KEY=

HELPDESK_PORT=8000
HELPDESK_HOST=0.0.0.0
HELPDESK_TIMEZONE=America/New_York
HELPDESK_OWNER=me

# Where the database lives. Default is ./data/helpdesk.db
# HELPDESK_DB_PATH=C:\Users\you\OneDrive - Org\Helpdesk\db\helpdesk.db
