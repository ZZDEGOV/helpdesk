# Copy to .env and edit.

# HELPDESK_PASSWORD is no longer used -- accounts replaced it in v2.0.
# On first run the app shows a setup page to create the root account.

# Username the v2.0 migration assigns existing tickets to.
HELPDESK_OWNER_USERNAME=ZachZ

HELPDESK_SESSION_DAYS=7
HELPDESK_MAX_FAILED_LOGINS=5
HELPDESK_LOCKOUT_MINUTES=15
HELPDESK_RETENTION_DAYS=7

HELPDESK_PORT=8000
HELPDESK_HOST=0.0.0.0
HELPDESK_TIMEZONE=America/New_York
HELPDESK_OWNER=me

# Where the database lives. Default is ./data/helpdesk.db
# HELPDESK_DB_PATH=C:\Users\you\OneDrive - Org\Helpdesk\db\helpdesk.db
