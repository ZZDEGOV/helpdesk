# Copy to .env for local development. In Docker, set these in compose.yaml instead.
# Every setting is optional; the defaults are shown.

# HELPDESK_DATA_DIR=./data
# HELPDESK_DB_PATH=./data/helpdesk.db
# HELPDESK_TIMEZONE=America/New_York

# Business hours: a ticket's target date means "by the end of the work day".
# HELPDESK_WORK_START=8
# HELPDESK_WORK_END=17

# HELPDESK_SESSION_DAYS=7
# HELPDESK_MAX_FAILED_LOGINS=5
# HELPDESK_LOCKOUT_MINUTES=15
# HELPDESK_RETENTION_DAYS=7

# Set to true once the app is served over HTTPS.
# HELPDESK_SECURE_COOKIES=false

# Extra names that mark a pasted email as written by the team (comma separated).
# The signed-in user's own username and display name are always included.
# HELPDESK_OWNER_HINTS=transit systems,helpdesk
